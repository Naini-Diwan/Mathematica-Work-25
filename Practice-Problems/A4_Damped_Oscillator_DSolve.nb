Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Kappa]", "=", "0.5"}], 
  RowBox[{"(*", 
   RowBox[{"Dimensionless", " ", "temprature"}], "*)"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", "=", "0.1"}], 
   RowBox[{"(*", "h", "*)"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "the", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalTheta]", "''"}], "[", "\[Tau]", "]"}], "==", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"1", "+", "\[Kappa]"}], ")"}]}], " ", 
           RowBox[{"\[CapitalTheta]", "[", "\[Tau]", "]"}]}], "-", 
          RowBox[{"\[Mu]", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"\[CapitalTheta]", "'"}], "[", "\[Tau]", "]"}], "]"}], 
           " ", 
           RowBox[{
            RowBox[{"\[CapitalTheta]", "'"}], "[", "\[Tau]", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"\[CapitalTheta]", "[", "0", "]"}], "==", "1"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalTheta]", "'"}], "[", "0", "]"}], "==", "0"}]}], 
       "}"}], ",", "\[CapitalTheta]", ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "100"}], "}"}]}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "solution", " ", "for", " ", "easier", " ", 
    "reference"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solExpr", "=", 
    RowBox[{
     RowBox[{"\[CapitalTheta]", "[", "\[Tau]", "]"}], "/.", " ", 
     RowBox[{"sol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "the", " ", "solution", " ", "with", " ", "enhanced", " ", 
    "styling"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "solExpr", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Tau]", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", "Green", "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Tau]\>\"", ",", "\"\<\[CapitalTheta](\[Tau])\>\""}], 
     "}"}]}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Bold", ",", "14"}], "]"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"\[CapitalTheta]", "[", "\[Tau]", "]"}], "]"}], ",", 
         "Bold"}], "]"}], "}"}], ",", "Top"}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
