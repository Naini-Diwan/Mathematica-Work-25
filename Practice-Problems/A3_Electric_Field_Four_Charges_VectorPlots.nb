Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v0", "=", "20"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "velocity"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", "9.8"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Acceleration", " ", "due", " ", "to", " ", "gravity"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"range", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"v0", "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "\[Theta]"}], "]"}]}], ")"}], "/", "g"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"range", "[", 
    RowBox[{"\[Theta]", " ", "Degree"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "90"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta] (Degrees)\>\"", ",", "\"\<Range (m)\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"Mark", " ", "the", " ", "max", " ", "range", " ", "point"}], 
      "*)"}], 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"45", ",", 
           RowBox[{"range", "[", 
            RowBox[{"45", " ", "Degree"}], "]"}]}], "}"}], "]"}]}], "}"}], 
      ",", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Max Range\>\"", ",", "Red"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"45", ",", 
          RowBox[{"range", "[", 
           RowBox[{"45", " ", "Degree"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "2"}]}], "}"}]}], "]"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{
  3.948946904994013*^9, 3.948947166670723*^9, 3.9489472260154896`*^9, {
