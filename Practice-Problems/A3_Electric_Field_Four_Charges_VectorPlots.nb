Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxRangeAngle", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"range", "[", "\[Theta]", "]"}], ",", "\[Theta]"}], "]"}], "==",
       "0"}], ",", "\[Theta]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"maxRangeAngleDegree", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Theta]", "/.", " ", "maxRangeAngle"}], ")"}], "*", 
    RowBox[{"180", "/", "Pi"}]}], "//", "N"}]}]}], "Input",
 CellChangeTimes->{
  3.9489469353485813`*^9, 3.9489469673754387`*^9, {3.948947051995428*^9, 
