Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"g", "=", "9.81"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Gravity", " ", "in", " ", 
     RowBox[{"m", "/", 
      RowBox[{"s", "^", "2"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"thetaGround", "=", 
     RowBox[{"0.5", " ", "Degree"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Ground", " ", "inclination", " ", "in", " ", "degrees"}], "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"v0", "=", "20"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "velocity", " ", "in", " ", 
     RowBox[{"m", "/", "s"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Function", " ", "for", " ", "projectile", " ", "motion"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ProjectilePath", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", "x", ",", "y"}], "}"}], ",", 
       RowBox[{
        RowBox[{"tmax", "=", 
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"v0", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "t"}], "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}], " ", "g", " ", 
               RowBox[{"t", "^", "2"}]}]}], "==", "0"}], ",", "t"}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Flight", " ", "time"}], "*)"}], 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"v0", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "t"}], ",", 
           RowBox[{
            RowBox[{"v0", " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "t"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], " ", "g", " ", 
             RowBox[{"t", "^", "2"}]}]}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ParametricPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"v0", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "t"}], ",", 
            RowBox[{
             RowBox[{"v0", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "t"}], "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], " ", "g", " ", 
              RowBox[{"t", "^", "2"}]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "50"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "20"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "inclined", " ", "ground"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"InclinedGround", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tan", "[", "thetaGround", "]"}], " ", "x"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "50"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", "Black"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "trajectories", " ", "for", " ", "different", " ", "launch", 
     " ", "angles"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"angles", "=", 
     RowBox[{"{", 
      RowBox[{"20", ",", "30", ",", "40", ",", "50", ",", "60", ",", "70"}], 
      "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Angles", " ", "in", " ", "degrees"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trajectories", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ProjectilePath", "[", 
        RowBox[{"\[Theta]", " ", "Degree"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "angles"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Show", " ", "final", " ", "plot"}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"trajectories", ",", "InclinedGround", ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Projectile Motion on an Inclined Plane (0.5\[Degree])\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"angles", ",", 
          RowBox[{"LegendLabel", "->", "\"\<Angle (\[Degree])\>\""}]}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"0.8", ",", "0.7"}], "}"}]}], "]"}]}]}], "]"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.9489504711596146`*^9, 3.9489504930146694`*^9}, {
  3.94895383993268*^9, 3.9489538414757843`*^9}, {3.9489542233117676`*^9, 
  3.9489542233276806`*^9}},
