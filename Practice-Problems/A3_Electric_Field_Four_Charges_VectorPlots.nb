04329e41bd0e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v0", "=", "20"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "velocity", " ", "in", " ", 
    RowBox[{"m", "/", "s"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "=", "9.8"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Acceleration", " ", "due", " ", "to", " ", "gravity", " ", "in", " ", 
    RowBox[{"m", "/", 
     RowBox[{"s", "^", "2"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]", "=", 
    RowBox[{"45", " ", "Degree"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Launch", " ", "angle", " ", "in", " ", "radians"}], "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Parametric", " ", "equations", " ", "for", " ", "the", " ", 
    "projectile"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "t_", "]"}], ":=", 
  RowBox[{"v0", "*", 
   RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", "t"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"v0", "*", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", "t"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], "*", "g", "*", 
     RowBox[{"t", "^", "2"}]}]}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Time", " ", "of", " ", "flight"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tflight", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", "v0", "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ")"}], "/", "g"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Parametric", " ", "plot", " ", "of", " ", "the", " ", "trajectory"}], 
   "*)"}]}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tflight"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"v0", "^", "2"}], "*", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Theta]"}], "]"}], "/", "g"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"v0", "^", "2"}], "*", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "g"}], ")"}]}]}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<Projectile Trajectory for \[Theta] = 45\[Degree]\>\""}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.948931229074257*^9, 3.948931247122156*^9}, {
  3.948931359045105*^9, 3.948931476937792*^9}, {3.949562865975008*^9, 
  3.9495629259059734`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"156d9374-9060-c14c-bc55-d468095c7edc"],

