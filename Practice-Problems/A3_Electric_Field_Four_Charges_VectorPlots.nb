Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", 
        SqrtBox["2"], 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "t"}], " ", ",", 
       RowBox[{
        RowBox[{"10", 
         SqrtBox["2"], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", "t"}], " ", "-", " ", 
        RowBox[{"4.9", " ", 
         SuperscriptBox["t", "2"]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "45"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "15"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x (m)\>\"", ",", "\"\<y (m)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Projectile Trajectory for \[Theta] = \>\"", ",", "\[Theta]"}], 
       "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     FractionBox["Pi", "2"]}], "}"}]}], "]"}]], "Input",
