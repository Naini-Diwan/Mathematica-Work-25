Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"v0", ",", "\[Theta]", ",", "\[Alpha]", ",", "tf", ",", "R"}], 
   "]"}], " ", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Acceleration", " ", "due", " ", "to", " ", "gravity", " ", "in", " ", 
    RowBox[{"m", "/", 
     RowBox[{"s", "^", "2"}]}], " ", "is", " ", "predefined", " ", "in", " ", 
    "mathematica"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"0.5", " ", "Degree"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Convert", " ", "degrees", " ", "to", " ", "radians"}], "*)"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Time", " ", "of", " ", "flight"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", "v0", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "-", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"Tan", "[", "\[Alpha]", "]"}]}]}], ")"}]}], ")"}], "/", 
     "g"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", "Range"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"R", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"v0", "^", "2"}], " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "-", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"Tan", "[", "\[Alpha]", "]"}]}]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"g", " ", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Alpha]", "]"}], "^", "2"}]}], ")"}]}]}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "4"}], ":", 
    RowBox[{
    "Differentiate", " ", "R", " ", "with", " ", "respect", " ", "to", " ", 
     "\[Theta]", " ", "and", " ", "solve", " ", "for", " ", 
     StyleBox["\[Theta]",
      FontWeight->"Bold"]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaOpt", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"R", ",", "\[Theta]"}], "]"}], "==", "0"}], "&&", 
       RowBox[{"0", "<", "\[Theta]", "<", 
        RowBox[{"Pi", "/", "2"}]}]}], ",", "\[Theta]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "5"}], ":", 
    RowBox[{
    "Extract", " ", "numerical", " ", "solutions", " ", "and", " ", "convert",
      " ", "to", " ", "degrees"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thetaOptDegrees", "=", 
   RowBox[{
    RowBox[{"\[Theta]", "/.", " ", "thetaOpt"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"thetaanswer", "=", 
  RowBox[{"thetaOptDegrees", "*", 
   RowBox[{"(", 
    RowBox[{"180", "/", "Pi"}], ")"}]}]}], "\n"}], "Input",
 CellChangeTimes->{{3.9489532236272182`*^9, 3.948953232245186*^9}, {
   3.9489538761032887`*^9, 3.948953876570814*^9}, {3.948953981656845*^9, 
