Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"F", "=", 
  RowBox[{"-", 
   RowBox[{"D", "[", 
    RowBox[{"V", ",", "x"}], "]"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "If", " ", "you", " ", "run", " ", "this", " ", "before", " ", "the", 
      " ", "previous", " ", "cell"}], ",", " ", 
     RowBox[{
      RowBox[{"it", "'"}], "ll", " ", "give", " ", 
      RowBox[{"0", "[", "obvio", "]"}]}]}], "*)"}]}]}]], "Input",
