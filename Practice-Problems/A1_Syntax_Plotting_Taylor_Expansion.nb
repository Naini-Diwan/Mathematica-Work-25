Cell[TextData[{
 StyleBox["Answer 2",
  FontWeight->"Bold"],
 "\nSyntax for sine wave is not sin {x}\nThe range of x should be put in \
braces, not parentheses.\nThe initial of Plot must be in uppercase.\nx_ \
should be the argument of g while defining it, not x. "
}], "Text",
 CellChangeTimes->{{3.9469506292596397`*^9, 3.946950668925812*^9}, {
  3.946950725077011*^9, 3.946950801528305*^9}, {3.9469508529132137`*^9, 
  3.94695087740736*^9}, {3.9469509262339973`*^9, 
  3.9469509409065533`*^9}},ExpressionUUID->"4da7ba9f-b8de-0545-9fc2-\
f83f9627f8f2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], "=", 
   RowBox[{"Sin", "[", "x", "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Code", " ", "to", " ", "Plot", " ", "a", " ", "sine", " ", "function"}], 
   "*)"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.946950674044771*^9, 3.9469507169769936`*^9}, {
  3.9469507575489273`*^9, 3.946950758043144*^9}, {3.9469508317829857`*^9, 
  3.946950839762951*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"8d2baba9-acfa-9a47-8320-f73b28fa1c2a"],

