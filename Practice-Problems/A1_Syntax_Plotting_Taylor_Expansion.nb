Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"Log", "[", 
      RowBox[{"Log", "[", "x", "]"}], "]"}], ",", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Log", "[", "x", "]"}], "]"}], ",", 
     RowBox[{"2", "^", "x"}], ",", 
     RowBox[{"2", "^", 
      RowBox[{"Log", "[", "x", "]"}]}], ",", 
     RowBox[{"4", "^", 
      RowBox[{"Log", "[", "x", "]"}]}], ",", 
     RowBox[{"x", "^", 
      RowBox[{"(", 
       RowBox[{"Log", "[", 
        RowBox[{"Log", "[", "x", "]"}], "]"}], ")"}]}], ",", 
     RowBox[{"x", "^", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Log", "[", "x", "]"}]}], ")"}]}], ",", 
     RowBox[{"Exp", "[", "x", "]"}], ",", 
     RowBox[{"Factorial", "[", 
      RowBox[{"x", ">", "0"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "21"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "8"}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", "\"\<Expressions\>\""}]}], "]"}]], "Input",
