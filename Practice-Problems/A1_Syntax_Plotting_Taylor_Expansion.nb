Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "t", "]"}], "-", 
     RowBox[{"t", "^", "2"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "1"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Finding", " ", "the", " ", "root", " ", "of", " ", "f", 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{"Sin", 
      RowBox[{"(", "t", ")"}]}], "-", 
     RowBox[{"t", "^", "2"}]}]}], "*)"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "t", "]"}], "-", 
    RowBox[{"t", "^", "2"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]}], "Input",
