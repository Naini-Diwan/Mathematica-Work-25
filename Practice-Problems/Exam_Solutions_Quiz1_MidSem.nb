 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", "\[Rule]", 
     RowBox[{"-", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", "\[Rule]", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9549301799756603`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"2a3c12aa-564a-e848-8518-48ec95a1ab43"]
}, Open  ]],

