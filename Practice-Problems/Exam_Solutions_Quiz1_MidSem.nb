}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "dimensionless", " ", "potential"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"U", "[", "rho_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "/", "rho"}], "-", 
      RowBox[{"1", "/", 
       RowBox[{"rho", "^", "2"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Compute", " ", "the", " ", "Taylor", " ", "expansion", " ", "around", 
      " ", "rho"}], " ", "=", " ", 
     RowBox[{"1", " ", "up", " ", "to", " ", "quadratic", " ", "order"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"taylorSeries", "=", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"U", "[", "rho", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rho", ",", "1", ",", "2"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "series", " ", "to", " ", "polynomial"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Uapprox", "[", "rho_", "]"}], "=", 
    RowBox[{"Normal", "[", "taylorSeries", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.954935724397812*^9, 3.954935724397812*^9}, 
   3.9549358728434525`*^9, {3.954936061676407*^9, 3.9549360888959427`*^9}, {
   3.954936221401726*^9, 3.9549362220774994`*^9}, {3.9549362617908993`*^9, 
   3.954936283917919*^9}, {3.9549865460959835`*^9, 3.954986562141308*^9}, {
   3.954986625001192*^9, 3.9549866267612267`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"04eb02b8-b3c9-3246-97cf-11c11c244c43"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "-", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"rho", "-", "1"}], ")"}], "2"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"rho", "-", "1"}], "]"}], "3"],
    SeriesData[$CellContext`rho, 1, {}, 0, 3, 1],
    Editable->False]}],
  SeriesData[$CellContext`rho, 1, {1, 0, -1}, 0, 3, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.9549865650658894`*^9, {3.9549866300515385`*^9, 3.9549866434516563`*^9}},
 CellLabel->"Out[18]=",ExpressionUUID->"21b38f46-c556-c94a-b5b9-3547e3a3eb18"],

Cell[BoxData[
 RowBox[{"1", "-", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "rho"}], ")"}], "2"]}]], "Output",
 CellChangeTimes->{
  3.9549865650658894`*^9, {3.9549866300515385`*^9, 3.9549866434516563`*^9}},
 CellLabel->"Out[19]=",ExpressionUUID->"35f7791e-32c0-7548-a2ee-b79d10544f76"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "both", " ", "the", " ", "original", " ", "potential", " ", 
    "and", " ", "the", " ", "Taylor", " ", "approximation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"U", "[", "rho", "]"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"Uapprox", "[", "rho", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"rho", ",", "0.5", ",", "1.5"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Original Potential\>\"", ",", "\"\<Taylor Approximation\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Rho]\>\"", ",", "\"\<Dimensionless Potential\>\""}], 
       "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\n", 
   "\n"}]}]], "Input",
