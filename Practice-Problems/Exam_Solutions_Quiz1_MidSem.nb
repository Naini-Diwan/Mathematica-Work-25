Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "r_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", "1"}], 
     SuperscriptBox["r", "2"]], "+", 
    FractionBox["2", 
     SuperscriptBox["r", "4"]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Mini", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"V", "[", "r", "]"}], ",", "r"}], "]"}], "==", "0"}], ",", 
    "r"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9549294135046043`*^9, 3.9549294137053604`*^9}, {
  3.954930091158758*^9, 3.9549301788519745`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"603fc17f-6d33-e945-b171-a62f4ea155c2"],

