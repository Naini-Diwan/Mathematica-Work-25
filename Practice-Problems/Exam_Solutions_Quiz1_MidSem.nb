Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"7", " ", "-", " ", 
     RowBox[{"Assume", " ", 
      FractionBox["1", 
       RowBox[{"4", 
        SubscriptBox["\[Pi]\[Epsilon]", "0"]}]]}]}], " ", "=", " ", "1"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"VectorPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox["q1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "+", "10"}], ")"}], "2"]], "+", 
         FractionBox["q2", 
          SuperscriptBox["x", "2"]], "+", 
         FractionBox["q3", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "10"}], ")"}], "2"]]}], ",", 
        FractionBox[
         RowBox[{"q1", "+", "q2", "+", "q3"}], 
         SuperscriptBox["x", "2"]]}], "}"}], ",", 
