Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "0", "]"}], "=", "2.0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"initial", " ", "value"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", "<", "1000"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"i", "+", "1"}], "]"}], "=", 
     RowBox[{
      RowBox[{"0.5", " ", 
       RowBox[{"x", "[", "i", "]"}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"x", "[", "i", "]"}], "]"}]}]}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"x", "[", "1000", "]"}]}], "Input",
 CellChangeTimes->{{3.954930643975868*^9, 3.954930645278387*^9}, {
  3.954930919916527*^9, 3.9549309276886196`*^9}, {3.9549309585943203`*^9, 
  3.9549309889117966`*^9}, {3.954931029509535*^9, 3.954931236863062*^9}, {
  3.954931408228897*^9, 3.9549314127200546`*^9}, {3.9549867520916004`*^9, 
  3.9549867672330055`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"dc3db60d-01e7-f842-94cf-b838ec3604d5"],

