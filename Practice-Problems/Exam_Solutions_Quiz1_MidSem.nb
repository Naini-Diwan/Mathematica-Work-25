Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Parameters", " ", "for", " ", "a", " ", "circular", " ", "Lissajous", " ",
     "figure"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"A1", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"A2", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Condition", ":", "A1"}], "=", "A2"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"omega", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Angular", " ", "frequency"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"phi1", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Phase", " ", "for", " ", "x1"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"phi2", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Phase", " ", "for", " ", "x2"}], ",", 
     RowBox[{
      RowBox[{"Condition", ":", 
       RowBox[{"phi2", "-", "phi1"}]}], "=", 
      RowBox[{
       RowBox[{"+", 
        RowBox[{"/", 
         RowBox[{"-", "Pi"}]}]}], "/", "2"}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "parametric", " ", "equations"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", "[", "t_", "]"}], ":=", 
    RowBox[{"A1", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"omega", " ", "t"}], "+", "phi1"}], "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"x2", "[", "t_", "]"}], ":=", 
    RowBox[{"A2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"omega", " ", "t"}], "+", "phi2"}], "]"}]}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "Lissajous", " ", "figure"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Parametric", " ", "functions", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "*)"}], 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", "omega"}]}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Parameter", " ", "range", " ", 
       RowBox[{"(", 
        RowBox[{"one", " ", "full", " ", "cycle"}], ")"}]}], "*)"}], 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Circular Lissajous Figure (A1=A2, \[Phi]2-\[Phi]1=\[Pi]/2)\>\""}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x1(t)\>\"", ",", "\"\<x2(t)\>\""}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Crucial", " ", "for", " ", "showing", " ", "a", " ", "true", " ", 
       "circle"}], "*)"}], 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.954990429096922*^9, 3.9549904394672127`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"56ef6578-0504-ae42-81c6-4e81176faedb"],

