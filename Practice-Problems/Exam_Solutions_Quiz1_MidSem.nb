Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "+", 
        RowBox[{"x", "[", "t", "]"}]}], "==", "0"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Differential", " ", "Equation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Initial", " ", "Condition", " ", "for", " ", "x"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Initial", " ", "Condition", " ", "for", " ", 
      RowBox[{"x", "'"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"x", "[", "t", "]"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Function", " ", "to", " ", "solve", " ", "for"}], "*)"}], 
    "\[IndentingNewLine]", "t"}], "                             ", 
   RowBox[{"(*", 
    RowBox[{"Independent", " ", "variable"}], "*)"}], "]"}], "\n"}]], "Input",
 CellChangeTimes->{{3.954990120030119*^9, 3.954990120030119*^9}, {
  3.9549902539305573`*^9, 
  3.954990281775255*^9}},ExpressionUUID->"98556ea5-0903-4e4a-b7e1-\
27a379d7a53f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "t"}], "/", "2"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9549901215550003`*^9, 3.9549902754497986`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"8e9bbb5f-fcf7-6d46-ab47-d6aac3fddac9"]
}, Open  ]],

