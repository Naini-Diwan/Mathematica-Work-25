Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "dimensionless", " ", "charge", " ", "and", " ", 
    "current"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"q", "[", "tau_", "]"}], ":=", 
    RowBox[{"Cos", "[", "tau", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"i", "[", "tau_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"Sin", "[", "tau", "]"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "dimensionless", " ", "charge", " ", "and", " ", "current", 
     " ", "vs", " ", "dimensionless", " ", "time"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plotting", " ", "over", " ", "two", " ", "periods", " ", 
     RowBox[{"(", 
      RowBox[{"0", " ", "to", " ", "4", "*", "Pi"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", "tau", "]"}], ",", 
       RowBox[{"i", "[", "tau", "]"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Functions", " ", "to", " ", "plot"}], "*)"}], 
     RowBox[{"{", 
      RowBox[{"tau", ",", "0", ",", 
       RowBox[{"4", "*", "Pi"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Plot", " ", "range", " ", "for", " ", "dimensionless", " ", "time"}], 
      "*)"}], 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Dimensionless Charge (q)\>\"", ",", 
        "\"\<Dimensionless Current (i)\>\""}], "}"}]}], ",", 
     RowBox[{"(*", "Legend", "*)"}], 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"Colors", " ", "for", " ", "the", " ", "curves"}], "*)"}], 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Dimensionless Time (\[Tau])\>\"", ",", 
        "\"\<Dimensionless Value\>\""}], "}"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"Axes", " ", "labels"}], "*)"}], 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Dimensionless Charge and Current in LC Circuit\>\""}], ",", 
     RowBox[{"(*", 
      RowBox[{"Plot", " ", "title"}], "*)"}], 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Add", " ", "grid", " ", "lines"}], "*)"}], 
     RowBox[{"ImageSize", "->", "Large"}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"Make", " ", "the", " ", "plot", " ", "larger"}], "*)"}], "]"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.954989725970087*^9, 
