Cell[TextData[{
 Cell[BoxData[
  RowBox[{"VectorPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      FractionBox["x", 
       SuperscriptBox[
        RowBox[{"(", 
