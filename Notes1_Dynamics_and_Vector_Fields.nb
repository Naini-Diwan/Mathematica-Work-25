Cell["\<\
Estimating the above as a quadratic function near extrema:
f(x) = -cosx
Taylor series approximation {x0 = 0}
f(x) = 1+(1/2)(x-2)^2\
\>", "Text",
 CellChangeTimes->{{3.9457365605345497`*^9, 3.945736592434372*^9}, {
  3.9457368305750904`*^9, 3.9457369577404633`*^9}, {3.9457370633596363`*^9, 
  3.9457370812154922`*^9}},ExpressionUUID->"3418c3c1-1d8c-0c49-b38c-\
4c6ae74fe6ca"],

