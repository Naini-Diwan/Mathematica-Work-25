Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "r"], "-", 
        FractionBox["1", "r1"]}], "}"}], "/.", 
      RowBox[{"r", "->", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["x", "2"], "+", 
          SuperscriptBox["y", "2"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]]}]}], " ", "/.", 
     RowBox[{"r1", "->", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "2"], "+", 
         SuperscriptBox["y", "2"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
    RowBox[{"Contours", "->", "10"}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"ContourLabels", "->", "True"}]}], "]"}]}]], "Input",
