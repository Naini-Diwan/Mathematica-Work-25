Cell[BoxData[
 RowBox[{"sol3", " ", "=", " ", 
  RowBox[{"D", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Log", "[", "x", "]"}], "x"], ",", "x"}], "]"}]}]], "Input",
