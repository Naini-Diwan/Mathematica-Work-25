Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"StreamPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox["x", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "+", 
           SuperscriptBox["y", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]]], "-", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], "2"], "+", 
           SuperscriptBox["y", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]]]}], ",", 
      RowBox[{
       FractionBox["y", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", 
            RowBox[{"2", " "}]], "+", 
           SuperscriptBox["y", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]]], "-", 
       FractionBox["y", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], "2"], "+", 
           SuperscriptBox["y", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}]]]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
    RowBox[{"RegionFunction", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "vx", ",", "vy"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ">", "0.05"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ">", "0.05"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.946336843244355*^9, 3.946336843514233*^9}, {
