Cell["\<\
To remove this numerical unstability at the origin, define a  RegionFunction\
\>", "Text",
 CellChangeTimes->{{3.946425495749401*^9, 
  3.946425524933964*^9}},ExpressionUUID->"b1bca741-5774-7c4d-8358-\
12a9c511331a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StreamPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "vx", ",", "vy"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}], ">", "0.05"}], "&&", " ", 
       RowBox[{"vx", ">", "0"}]}]}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9464255441640644`*^9, 3.9464257373046665`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"989abb51-58f4-f34a-9874-80a7e2a10570"],

