Cell["\<\
To get multiple roots, and substitute back into the equation, you need to \
define a function.\
\>", "Text",
 CellChangeTimes->{
  3.947330144303236*^9},ExpressionUUID->"ba7afbf7-3c54-1648-a8af-\
cf03046caa7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}]}], " ", "+", 
    RowBox[{"2", " ", "x"}], " ", "-", " ", "1"}], "/.", 
   RowBox[{"sol", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.9471201354805603`*^9, 3.9471201812978706`*^9}, {
