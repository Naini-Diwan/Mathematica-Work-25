Cell[BoxData[
 RowBox[{"StreamPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["x", 
         SuperscriptBox["r", "3"]], "-", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1"}], ")"}], 
         SuperscriptBox["r1", "3"]]}], ",", 
       RowBox[{
        FractionBox["y", 
         SuperscriptBox["r", "3"]], "-", 
        FractionBox["y", 
         SuperscriptBox["r1", "3"]]}]}], "}"}], "/.", 
     RowBox[{"r", "->", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]]}]}], " ", "/.", 
    RowBox[{"r1", "->", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1"}], ")"}], "2"], "+", 
        SuperscriptBox["y", "2"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"RegionFunction", "->", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "vx", ",", "vy"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ">", "0.05"}], "&&", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ">", "0.05"}]}]}], "]"}]}]}], 
