Cell["\<\
HA: Write a C code for Bisection method
/* Program: Finding real roots of nonlinear
   equation using Bisection Method */
#include<stdio.h>
#include<math.h>
#define f(x) 5*x*x*x + 9*x*x + 2*x + 3
float main()
{
   float x0, x1, x2, f0, f1, f2, e;
   int step = 1;
   /* Inputs */
   up:
   printf(\[OpenCurlyDoubleQuote]\\nEnter two initial guesses:\\n\
\[CloseCurlyDoubleQuote]);
   scanf(\[OpenCurlyDoubleQuote]%f%f\[CloseCurlyDoubleQuote], &x0, &x1);
   printf(\[OpenCurlyDoubleQuote]Enter tolerable error:\\n\
\[CloseCurlyDoubleQuote]);
   scanf(\[OpenCurlyDoubleQuote]%f\[CloseCurlyDoubleQuote], &e);
   /* Calculating Functional Value */
   f0 = f(x0);
   f1 = f(x1);
   /* Checking whether given guesses brackets the root or not. */
   if( f0 * f1 > 0.0)
   {
      printf(\[OpenCurlyDoubleQuote]Incorrect Initial Guesses.\\n\
\[CloseCurlyDoubleQuote]);
      goto up;
   }
   /* Implementing Bisection Method */
   printf(\[OpenCurlyDoubleQuote]\\nStep\\t\\tx0\\t\\tx1\\t\\tx2\\t\\tf(x2)\\\
n\[CloseCurlyDoubleQuote]);
   do
   {
      x2 = (x0 + x1)/2;
      f2 = f(x2);
      printf(\[OpenCurlyDoubleQuote]%d\\t\\t%f\\t%f\\t%f\\t%f\\n\
\[CloseCurlyDoubleQuote],step, x0, x1, x2, f2);
      if( f0 * f2 < 0)
      {
         x1 = x2;
         f1 = f2;
      }
      else
      {
         x0 = x2;
         f0 = f2;
      }
      step = step + 1;
   }while(fabs(f2)>e);
   printf(\[OpenCurlyDoubleQuote]\\nRoot is: %f\[CloseCurlyDoubleQuote], x2);
}\
\>", "Text",
 CellChangeTimes->{{3.945304830070368*^9, 3.945304848862797*^9}, {
   3.945304915131315*^9, 3.9453049155390854`*^9}, 3.9453051257275467`*^9, {
   3.945319787794077*^9, 
   3.9453198511171913`*^9}},ExpressionUUID->"8d75b79c-bff2-bc49-9341-\
ed2d2d92e507"],

