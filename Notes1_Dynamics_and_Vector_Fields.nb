       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ">", "0.2"}]}], "]"}]}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]], "Input",
