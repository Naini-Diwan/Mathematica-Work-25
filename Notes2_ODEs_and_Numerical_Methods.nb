Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"-", 
       RowBox[{"y2", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"y2", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"-", 
       RowBox[{"x2", "[", "t", "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x2", "[", "t", "]"}], ",", 
     RowBox[{"y2", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.9475512521166267`*^9, 3.947551373544443*^9}, {
  3.9475514060229053`*^9, 3.947551526989641*^9}, {3.947551566081314*^9, 
  3.9475515680380135`*^9}, {3.9475516822326717`*^9, 3.947551684218075*^9}, {
