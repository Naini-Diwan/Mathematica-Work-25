}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x5", "''"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"x5", "[", "t", "]"}]}], "-", 
     RowBox[{
      RowBox[{"x5", "'"}], "[", "t", "]"}]}]}], ",", 
   RowBox[{"x5", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{
  3.9482694478254166`*^9, {3.9489722834836674`*^9, 3.9489723154315453`*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"16f098ae-faae-494c-afea-17f7e43214af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x5", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "2"}]], " ", 
      TemplateBox[{"2"},
       "C"], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "t"}], "/", "2"}]], " ", 
      TemplateBox[{"1"},
       "C"], " ", 
      RowBox[{"Sin", "[", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9482694488755474`*^9, 3.948971885791252*^9, 3.948971937162363*^9, {
