  "Out[223]=",ExpressionUUID->"b6a8bd0e-9e84-c24e-8259-a87aa418b44a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"x1", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x1", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"x1", "[", "t", "]"}], ",", "t"}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold"], "\[FilledSmallCircle]"], 
     StyleBox["[",
      FontWeight->"Bold"], 
     StyleBox["t",
      FontWeight->"Bold"], 
     StyleBox["]",
      FontWeight->"Bold"]}], " ", 
    RowBox[{"won", "'"}], "t", " ", 
    RowBox[{"help", "!"}]}], "*)"}]}]], "Input",
