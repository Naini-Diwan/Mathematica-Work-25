Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x", "[", "t", "]"}]}], "-", 
        RowBox[{"0.5", " ", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], 
         SuperscriptBox[
          RowBox[{"x", "[", "t", "]"}], "2"]}]}]}], ",", 
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], " ", "throws", " ", 
    "error"}], "*)"}], " "}]], "Input",
