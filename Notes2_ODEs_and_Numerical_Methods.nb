        RowBox[{"0.5", " ", 
         RowBox[{
          RowBox[{"x9", "'"}], "[", "t", "]"}], " ", 
         SuperscriptBox[
          RowBox[{"x9", "[", "t", "]"}], "2"]}]}]}], ",", 
      RowBox[{
       RowBox[{"x9", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x9", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"x9", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}]], "Input",
