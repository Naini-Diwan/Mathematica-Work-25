Cell[TextData[StyleBox["\n[04-02-2025]\nDamped LCR circuit -  initial value \
problem", "Subtitle"]], "Text",
 CellChangeTimes->{{3.947633049852566*^9, 3.9476330661831875`*^9}, {
   3.9482706952801647`*^9, 3.9482706968521843`*^9}, 3.948270754868759*^9, {
   3.9482709079383755`*^9, 
   3.9482709157892857`*^9}},ExpressionUUID->"5a3061b8-0f8a-0f44-a23a-\
9299efc7aaa8"],

Cell[TextData[{
 StyleBox["\tL ",
  FontSize->20,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["di", "dt"], "=", 
    FractionBox[
     RowBox[{"-", "Q"}], "C"]}], TraditionalForm]],
  FontSize->20,ExpressionUUID->"d1fabe3a-b10b-2a46-925d-c600c3004f02"],
 StyleBox["- Ri\n\[Rule]     ",
  FontSize->20,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["d", "2"], "Q"}], 
     SuperscriptBox["dt", "2"]], "=", 
    FractionBox[
     RowBox[{"-", "Q"}], "LC"]}], TraditionalForm]],
  FontSize->20,ExpressionUUID->"bf290caa-91be-3947-a6f7-832f00289236"],
 StyleBox["- ",
  FontSize->20,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["R", "L"], 
    FractionBox["dQ", "dt"]}], TraditionalForm]],
  FontSize->20,ExpressionUUID->"15f06992-5830-0f4e-8ae4-62b7e2bd90ee"],
 "\n ",
 StyleBox["\n",
  FontSize->20],
 StyleBox["Relevant time scales (as there\[CloseCurlyQuote]s no length here) \
of this system",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["\n1) Of the oscillation of charge(restoring term): ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SqrtBox["LC"]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"91a9b700-a9e7-5e4c-83e6-b9d3cf7977dc"],
 StyleBox["\n2) Of the damping term: ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   FractionBox["L", "R"], TraditionalForm]],
  FontSize->18,ExpressionUUID->"2a7be844-6d08-8849-851a-999bc103650f"],
 StyleBox["\n3) Emergent time scale(derived from the above two): RC",
  FontSize->18]
}], "Text",
 CellChangeTimes->{
  3.947633089752939*^9, {3.9476331339506893`*^9, 3.947633177932808*^9}, {
   3.947633216057453*^9, 3.9476332338473053`*^9}, {3.9476332932364388`*^9, 
   3.9476333266012955`*^9}, {3.947633369940237*^9, 3.9476335423961945`*^9}, {
   3.947633593451933*^9, 3.9476337858925037`*^9}, {3.9476338210138226`*^9, 
   3.94763384065444*^9}},ExpressionUUID->"ff947090-10b2-de4c-9d21-\
403ee366f024"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"This", " ", "cell", " ", "throws", " ", "an", " ", 
   RowBox[{"error", "!"}], "\[IndentingNewLine]", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"x", "[", "t", "]"}]}], "-", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "\[IndentingNewLine]", 
   "Why", " ", "does", " ", "this", " ", "throw", " ", "error", " ", "for", 
   " ", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "?", " ", "Cz"}], " ", "too", " ", "many", 
   " ", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "'"}], "s", " ", "kill", " ", "the", " ", 
   "purpose"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9482359346778812`*^9, 3.9482359564246445`*^9}, {
  3.948271121252865*^9, 3.9482711350775642`*^9}, {3.9482718958914223`*^9, 
  3.948271907462919*^9}, {3.9489726777282085`*^9, 
