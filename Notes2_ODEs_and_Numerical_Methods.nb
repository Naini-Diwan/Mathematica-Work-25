Cell[CellGroupData[{

Cell["Predictor-corrector approach", "Subtitle",
 CellChangeTimes->{{3.9489751124177094`*^9, 
  3.948975115840948*^9}},ExpressionUUID->"15a65c0b-f94a-4543-83ea-\
da5f4a00536f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "function"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"t_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "x"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xi", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ti", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tf", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nmax", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"tf", "-", "ti"}], ")"}], "/", "nmax"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", "size"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initialize", " ", "storage"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datalist", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xprev", "=", "xi"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tprev", "=", "ti"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"datalist", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist", ",", 
       RowBox[{"{", 
        RowBox[{"tprev", ",", "xprev"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Modified", " ", 
     RowBox[{"Euler", "'"}], "s", " ", "Method"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"n", "=", "1"}], ",", 
     RowBox[{"n", "<=", "nmax"}], ",", 
     RowBox[{"n", "++"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Predictor", " ", "step"}], "*)"}], 
     RowBox[{
      RowBox[{"xpredictor", "=", 
       RowBox[{"xprev", "+", 
        RowBox[{"h", " ", 
         RowBox[{"f", "[", 
          RowBox[{"tprev", ",", "xprev"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Corrector", " ", "step", " ", "using", " ", "an", " ", "average", " ",
         "slope"}], "*)"}], 
      RowBox[{"tnext", "=", 
       RowBox[{"tprev", "+", "h"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xnext", "=", 
       RowBox[{"xprev", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", "/", "2"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"tprev", ",", "xprev"}], "]"}], "+", 
           RowBox[{"f", "[", 
            RowBox[{"tnext", ",", "xpredictor"}], "]"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Store", " ", "result"}], "*)"}], 
      RowBox[{"datalist", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"datalist", ",", 
         RowBox[{"{", 
          RowBox[{"tnext", ",", "xnext"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Update", " ", "variables"}], "*)"}], 
      RowBox[{"xprev", "=", "xnext"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tprev", "=", "tnext"}], ";"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "result"}], "*)"}], "\n", 
   RowBox[{"datalist", ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9489750494543114`*^9, 3.9489750714151*^9}},
 CellLabel->
  "In[302]:=",ExpressionUUID->"def7e864-7965-be49-a00e-84a732ce3353"]
}, Open  ]]
