  3.9477227505096664`*^9}},ExpressionUUID->"59745a57-4089-6e40-9ed7-\
539614236662"],

Cell[TextData[{
 "{From the notebook in classroom}\n",
 StyleBox["Linear Superposition of Oscillations", "Subtitle"]
}], "Text",
 CellChangeTimes->{{3.9477238110931034`*^9, 
  3.9477238594508057`*^9}},ExpressionUUID->"ae89c63b-6881-ae49-8a01-\
9a9ba4dfec3f"],

Cell[TextData[{
 "Only valid when the force is linear, for instance\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "\[FilledSmallCircle]\[FilledSmallCircle]"], "=", 
    RowBox[{"-", 
     SuperscriptBox["\[Omega]", 
      RowBox[{"2", " "}]]}]}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"cd344372-00ca-3742-9782-6d2307f5946d"],
 StyleBox["x",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9477239396410465`*^9, 3.9477239796839886`*^9}, {
   3.9477240365739765`*^9, 3.9477241023954716`*^9}, 
   3.948973044761133*^9},ExpressionUUID->"1a707ee0-9787-e446-bd0d-\
a5ee2ec5bb8b"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "RandomReal", " ", "gives", " ", "a", " ", "random", " ", "value", " ", 
   "between", " ", "0", " ", "and", " ", 
   StyleBox["\[Pi]",
    FontWeight->"Bold"]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9477241395714035`*^9, 3.947724173699707*^9}, 
   3.948973092714823*^9},ExpressionUUID->"32893bb0-cf13-a446-b0a7-\
39d8a5df173f"],

Cell[TextData[{
 "Both the frequencies must ",
 StyleBox["commensurate",
  FontWeight->"Bold"],
 ": If the fraction ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox["\[Omega]", "1"], 
    RowBox[{
     SubscriptBox["\[Omega]", "2"], " "}]], TraditionalForm]],ExpressionUUID->
  "da006aa0-f41f-a64e-980b-aefc9850c344"],
 " is rational, only then the superposition is periodic. Reason being, there \
must be a rational common multiple of the constituent waves."
}], "Text",
 CellChangeTimes->{{3.947724433262987*^9, 3.9477245860649433`*^9}, {
  3.9477246756752796`*^9, 3.9477246924788685`*^9}, {3.9489731109562263`*^9, 
  3.9489731292297325`*^9}},ExpressionUUID->"03e3fad0-e2f5-c243-9ea8-\
b7ef2a140c43"],

