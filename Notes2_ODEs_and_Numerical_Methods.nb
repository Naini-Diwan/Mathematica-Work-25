Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"y", "[", "t", "]"}]}], "-", 
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.9482709817123833`*^9, 3.9482709826936913`*^9}, 
   3.9482710287917557`*^9, {3.9482710966890774`*^9, 3.948271113237236*^9}, {
   3.94827143992165*^9, 3.9482714450716248`*^9}, 3.9482715338414116`*^9, {
   3.948271587997694*^9, 3.9482716643336487`*^9}, {3.9482717322017193`*^9, 
   3.948271744797594*^9}, {3.9482718110220776`*^9, 3.9482718415506096`*^9}, {
   3.9482720130830593`*^9, 3.948272027321516*^9}, {3.9489725706810246`*^9, 
   3.948972600311388*^9}, {3.9489727194155064`*^9, 3.948972720273266*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"75ed9636-0b3b-914f-bd3a-664f739cf486"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "t"}], "/", "2"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.948270983745037*^9, 3.9482709963510876`*^9}, {
   3.9482710295908413`*^9, 3.948271040073097*^9}, 3.948271114528303*^9, {
   3.948271440748884*^9, 3.9482714460069904`*^9}, 3.948271534421713*^9, {
   3.9482716218935833`*^9, 3.9482716649774036`*^9}, 3.9482717453627224`*^9, 
   3.94827182709194*^9, 3.9489718862570534`*^9, 3.9489719376494007`*^9, 
   3.948972567285801*^9, 3.948972734715231*^9},
 CellLabel->
  "Out[268]=",ExpressionUUID->"c2368111-fa2c-5a48-9d16-364dbeb4bfc2"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Gamma]"}], " ", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
         RowBox[{"x", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.947635316460388*^9, {3.9476353689999065`*^9, 3.9476354609192142`*^9}, 
