       RowBox[{
        RowBox[{
         RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"-", 
         RowBox[{"y2", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y2", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"-", 
         RowBox[{"x2", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"x2", "[", "0", "]"}], "==", "2"}], ",", 
       RowBox[{
        RowBox[{"y2", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x2", "[", "t", "]"}], ",", 
       RowBox[{"y2", "[", "t", "]"}]}], "}"}], ",", "t"}], "]"}]}]}]], "Input",
