Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dsol1", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x6", "''"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"x6", "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"x6", "'"}], "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x6", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x6", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
    RowBox[{"x6", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.947552460040657*^9, 3.947552501094103*^9}, {
  3.9475525338393097`*^9, 3.9475525363557396`*^9}, {3.9482695010428753`*^9, 
  3.9482695194351845`*^9}, {3.948972376229841*^9, 3.948972385051964*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"31bd9525-ac2d-1243-95b2-d57bbc24d5fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x6", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "t"}], "/", "2"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Cos", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}], "+", 
       RowBox[{
        SqrtBox["3"], " ", 
        RowBox[{"Sin", "[", 
         FractionBox[
          RowBox[{
           SqrtBox["3"], " ", "t"}], "2"], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9475525036674557`*^9, 3.947552610438854*^9, {3.948269505306959*^9, 
   3.948269520048706*^9}, 3.9489718858212376`*^9, 3.9489719371874027`*^9, 
