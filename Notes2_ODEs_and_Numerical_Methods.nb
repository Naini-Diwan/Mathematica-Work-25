Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"For", " ", "loop"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sum", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", " ", "[", 
    RowBox[{
     RowBox[{"k", " ", "=", " ", "1"}], ",", 
     RowBox[{"(*", "Initialisation", "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{"k", "<=", " ", "119999"}], ",", " ", 
     RowBox[{"(*", "Condition", "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{"k", "++"}], ",", " ", 
     RowBox[{"(*", "Increment", "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{"sum", " ", "=", " ", 
      RowBox[{"sum", " ", "+", " ", 
       FractionBox["1", 
        SuperscriptBox["k", "2"]]}]}]}], " ", 
    RowBox[{"(*", "body", "*)"}], "\[IndentingNewLine]", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sum", "//", "N"}], "//", "Timing"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Does", " ", "the", " ", "same", " ", "thing", " ", "as", " ", "table"}],
      ",", " ", 
     RowBox[{"but", " ", "for", " ", "loop", " ", "is", " ", 
      StyleBox["slower",
