Cell[TextData[StyleBox["Modified Euler\[CloseCurlyQuote]s", "Subtitle"]], \
"Text",
 CellChangeTimes->{{3.9487638013656025`*^9, 
  3.9487638073391666`*^9}},ExpressionUUID->"50dd7b9a-de5a-5146-b25b-\
1ca19edb5a4e"],

Cell["\<\
Where we don\[CloseCurlyQuote]t neglect Taylor\[CloseCurlyQuote]s terms upto \
2nd power. Given that in the following example, 
At x=0, y=1 with the step size of 0.5 .\
\>", "Text",
 CellChangeTimes->{{3.948763849328045*^9, 3.9487638834318542`*^9}, {
  3.948763987474865*^9, 3.9487639879134407`*^9}, {3.948764116267458*^9, 
  3.948764180160265*^9}},ExpressionUUID->"4f427bf6-728e-1f45-a089-\
7015c21cb71a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    SuperscriptBox["x", "3"]}], "+", 
   RowBox[{"12", " ", 
    SuperscriptBox["x", "2"]}], "-", 
   RowBox[{"20", " ", "x"}], " ", "+", "8.5"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", " ", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xf", " ", "=", " ", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "0", "]"}], "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmax", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"tf", "-", "ti"}], "nmax"], ")"}], "//", "N"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "size"}], ",", " ", 
    RowBox[{"the", " ", "less", " ", "the", " ", "better"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xprev", " ", "=", " ", "xi"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tprev", " ", "=", " ", "ti"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"datalist", ",", 
     RowBox[{"{", 
      RowBox[{"tprev", ",", "xprev"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "<=", "nmax"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tnext", "=", 
     RowBox[{"tprev", "+", "h"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xnext", "=", 
     RowBox[{"xprev", "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "[", 
        RowBox[{"tprev", ",", "xprev"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"datalist", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist", ",", 
       RowBox[{"{", 
        RowBox[{"tnext", ",", "xnext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xprev", "=", "xnext"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"tprev", "=", "tnext"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.948974847738798*^9, 
  3.94897489582847*^9}},ExpressionUUID->"bc804f19-3e87-a340-9448-\
58ec9861a2ba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", " ", "=", 
   FractionBox[
    RowBox[{" ", 
     RowBox[{"xf", "-", 
      RowBox[{"x", "[", "0", "]"}]}]}], "nmax"]}], 
  RowBox[{"(*", 
   RowBox[{"Step", " ", "size"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"At", " ", "any", " ", "time", " ", "t"}], ",", " ", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "=", 
     RowBox[{"x", ".", " ", 
      RowBox[{"Then", ":"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", "x", "]"}], "=", " ", 
  RowBox[{
   RowBox[{"y", "[", 
    RowBox[{"x", "-", "1"}], "]"}], "+", 
   RowBox[{"f2", "[", 
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"t", "-", "1"}], "]"}], ",", 
     RowBox[{"y", "[", 
      RowBox[{"x", "-", "1"}], "]"}]}], "]"}], "+", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"f2", ",", "x"}], "]"}], "."}], "/"}]}]}]}], "Input",
 CellChangeTimes->{{3.9487641885988407`*^9, 3.9487642021591797`*^9}, {
  3.9487642871293716`*^9, 3.948764302096098*^9}, {3.948764409343073*^9, 
  3.9487644124721985`*^9}, {3.948764486616205*^9, 3.948764614407118*^9}, {
  3.9487646480168056`*^9, 3.948764652012308*^9}, {3.948764686316168*^9, 
  3.9487647751075306`*^9}},
 CellLabel->
  "In[221]:=",ExpressionUUID->"51ab5201-3cbe-3242-b92a-acec1209c611"],

Cell[BoxData[
 FractionBox["1", "25"]], "Output",
 CellChangeTimes->{3.94897189155097*^9, 3.948971942141243*^9},
