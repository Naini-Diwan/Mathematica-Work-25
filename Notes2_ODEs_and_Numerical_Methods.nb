Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "auxilary", " ", "conditions", " ", "need", " ", "to", " ", 
    "be", " ", "defined", " ", "for", " ", "determining", " ", "the", " ", 
    "constants"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"dsol", "=", 
