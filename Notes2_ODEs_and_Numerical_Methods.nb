Cell[TextData[{
 StyleBox["Euler\[CloseCurlyQuote]s method\n", "Subtitle"],
 StyleBox["To solve initial value problems numerically. \nSay the DE is given \
by-\n",
  FontSize->15],
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "."], TraditionalForm]],
  FontSize->15,
  FontSlant->"Italic",ExpressionUUID->"e9e313a7-37c9-e840-b5e3-9ea81b03dc15"],
 StyleBox[" =  f(x,t)\n",
  FontSize->15,
  FontSlant->"Italic"],
 StyleBox["\nTo solve it, we discretize the time such that the step size is -\
\n",
  FontSize->15],
 Cell[BoxData[
  FormBox[
   RowBox[{"h", " ", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["t", "n"], "-", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]]}], "=", 
     FractionBox[
      RowBox[{
       SubscriptBox["t", "f"], " ", "-", 
       SubscriptBox["t", "0"]}], "N"]}]}], TraditionalForm]],
  FontSize->15,
  FontSlant->"Italic",ExpressionUUID->"aedf0d29-b67f-1f47-b356-e2b5787112c7"],
 StyleBox["\nthen-\n",
  FontSize->15],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{"initial", " ", "value"}]}], TraditionalForm]],
  FontSize->15,ExpressionUUID->"6f3b2210-1e2c-6049-a0a2-6eb0a7fcd0dc"],
 StyleBox["\n",
  FontSize->15,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["x", "n"], "+", 
     RowBox[{"hf", "(", 
      RowBox[{
       SubscriptBox["x", "n"], ",", 
       SubscriptBox["t", "n"]}], ")"}]}]}], TraditionalForm]],
  FontSize->15,ExpressionUUID->"af3ee90a-cbd4-8346-bcd7-363d3cc14096"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.948330121371561*^9, 3.9483301257735615`*^9}, {
  3.948758256122242*^9, 3.948758289462036*^9}, {3.948758343923666*^9, 
  3.948758354897352*^9}, {3.948758398232933*^9, 3.9487584718823166`*^9}, {
  3.9487585091378384`*^9, 3.9487586606870785`*^9}, {3.948763045408804*^9, 
  3.948763045409813*^9}, {3.948763078111109*^9, 3.9487630895616646`*^9}, {
  3.9487631708691216`*^9, 3.948763174701271*^9}, {3.948763206564396*^9, 
  3.9487632956978493`*^9}, {3.9487633302394924`*^9, 3.9487633426485596`*^9}, {
  3.9487633996418133`*^9, 3.9487634310825367`*^9}, {3.948763488769335*^9, 
  3.9487635616740456`*^9}},
 FontSize->12,ExpressionUUID->"4648c590-1d37-a34f-a20e-eb62cdcbcd76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "x"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ti", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tf", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmax", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"tf", "-", "ti"}], "nmax"], ")"}], "//", "N"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "size"}], ",", " ", 
    RowBox[{"the", " ", "less", " ", "the", " ", "better"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xprev", " ", "=", " ", "xi"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tprev", " ", "=", " ", "ti"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"datalist", ",", 
     RowBox[{"{", 
      RowBox[{"tprev", ",", "xprev"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "<=", "nmax"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tnext", "=", 
     RowBox[{"tprev", "+", "h"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xnext", "=", 
     RowBox[{"xprev", "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "[", 
        RowBox[{"tprev", ",", "xprev"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"datalist", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist", ",", 
       RowBox[{"{", 
        RowBox[{"tnext", ",", "xnext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xprev", "=", "xnext"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"tprev", "=", "tnext"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9483301339722557`*^9, 3.948330224851469*^9}, {
   3.948330303239025*^9, 3.9483304226380024`*^9}, {3.9483304766359367`*^9, 
   3.9483305133078785`*^9}, {3.9483305518953094`*^9, 3.948330566765442*^9}, {
