  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "1"}], ";", 
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], "=", "1"}]}], ",", 
   RowBox[{"(*", 
    RowBox[{"Semi", "-", 
     RowBox[{
     "colons", " ", "separate", " ", "the", " ", "two", " ", "in", " ", "the",
       " ", "same", " ", "part", " ", "of", " ", "for", " ", "loop"}]}], 
    "*)"}], "\[IndentingNewLine]", 
