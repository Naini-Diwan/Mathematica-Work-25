Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"v", "''"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"v", "[", "t", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"v", "'"}], "[", "t", "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"v", "[", "0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"v", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.9476351972910366`*^9, 3.947635208499712*^9}, 
