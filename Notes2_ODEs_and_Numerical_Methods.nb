Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "x"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ti1", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tf1", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nmax1", "=", "1000"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Increased", " ", "nmax"}], " ", "=", 
    RowBox[{">", " ", 
     RowBox[{"more", " ", "precision"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h1", "=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"tf1", "-", "ti1"}], "nmax1"], ")"}], "//", "N"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Smaller", " ", "the", " ", "stepsize"}], ",", " ", 
    RowBox[{"less", " ", "will", " ", "be", " ", "the", " ", "error"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xprev1", "=", " ", "xi1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tprev1", "=", " ", "ti1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist1", " ", "=", " ", 
   RowBox[{"Append", "[", 
    RowBox[{"datalist1", ",", 
     RowBox[{"{", 
      RowBox[{"tprev1", ",", "xprev1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "<=", "nmax1"}], ",", "\[IndentingNewLine]", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tnext1", "=", 
     RowBox[{"tprev1", "+", "h1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xnext1", "=", 
     RowBox[{"xprev1", "+", 
      RowBox[{"h1", " ", 
       RowBox[{"f", "[", 
        RowBox[{"tprev1", ",", "xprev1"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"datalist1", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist1", ",", 
       RowBox[{"{", 
        RowBox[{"tnext1", ",", "xnext1"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xprev1", "=", "xnext1"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"tprev1", "=", "tnext1"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solutionplot1", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "ti1", ",", "tf1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataplot1", " ", "=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"datalist1", ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"solutionplot1", ",", "dataplot1"}], "]"}]}], "Input",
