   3.948974494734188*^9},ExpressionUUID->"0a42835c-611e-3f43-b64d-\
c8aee5f5de94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataplot", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"datalist", ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solutionplot", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "ti", ",", "tf"}], "}"}]}], "]"}]}], ";"}]}], "Input",
