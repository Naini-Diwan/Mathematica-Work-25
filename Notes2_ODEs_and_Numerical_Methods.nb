Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x4", "''"}], "[", "t", "]"}], "==", 
    RowBox[{"-", 
     RowBox[{"x4", "[", "t", "]"}]}]}], ",", 
   RowBox[{"x4", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.947552264113098*^9, 3.9475522661282597`*^9}, {
  3.947552296812187*^9, 3.947552320721258*^9}, {3.9475523510785236`*^9, 
  3.9475523762183876`*^9}, {3.9475524385266457`*^9, 3.9475524505767174`*^9}, {
  3.948269233237911*^9, 3.9482692365259323`*^9}, {3.94897226555896*^9, 
  3.948972271219515*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"1cb929d2-34e4-4f44-bf1f-952231991bb5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x4", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], " ", 
      RowBox[{"Cos", "[", "t", "]"}]}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9475523236013355`*^9, 3.9475523775511475`*^9}, 
