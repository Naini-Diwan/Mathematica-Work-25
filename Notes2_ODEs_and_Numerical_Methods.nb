Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"z", "[", "t", "]"}]}]}], ",", 
    RowBox[{"z", "[", "t", "]"}], ",", "t"}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{
  3.947550426436487*^9, {3.9475506462412815`*^9, 3.9475506557157726`*^9}, {
   3.947550701448763*^9, 3.9475507245130825`*^9}, {3.9475507784991283`*^9, 
   3.9475508161412926`*^9}, {3.9475508663150826`*^9, 
   3.9475508816948147`*^9}, {3.947551021284477*^9, 3.947551053600298*^9}, {
   3.948971972201193*^9, 3.9489719774387283`*^9}},
 CellLabel->
  "In[223]:=",ExpressionUUID->"f78d4498-e7b3-fa4d-8f57-564030a3ad9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"z", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "t"}]], " ", 
     TemplateBox[{"1"},
      "C"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.947550869438755*^9, 3.9475508822289352`*^9}, 
