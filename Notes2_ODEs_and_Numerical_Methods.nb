Cell["\<\
HA: Take a function which isn\[CloseCurlyQuote]t analytically solvable, and \
evaluate it numerically.\
\>", "Text",
 CellChangeTimes->{{3.9475505746280804`*^9, 3.94755061507852*^9}, {
   3.9475506662757206`*^9, 3.947550691988737*^9}, {3.947550766472471*^9, 
   3.94755077189122*^9}, 
   3.9482686504098015`*^9},ExpressionUUID->"791222ee-b734-9d4d-94cb-\
8c0afaf07df8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox["x", "2"]}], "2"], "]"}], 
     RowBox[{"2", " ", "Pi"}]], ",", "x"}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Can", "'"}], "t", " ", "be", " ", "evaluated", " ", 
    RowBox[{"analytically", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "NIntegrate", " ", "needs", " ", "a", " ", "range", " ", "for", " ", 
    "independent", " ", "variable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", 
       SuperscriptBox["x", "2"]}], "2"], "]"}], 
    RowBox[{"2", " ", "Pi"}]], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9482686546611176`*^9, 3.9482687467608204`*^9}, {
  3.948268987183527*^9, 3.948269042815483*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"eedf9a93-9448-c746-8dca-aae43ab60bce"],

Cell[BoxData[
 FractionBox[
  RowBox[{"Erf", "[", 
   FractionBox["x", 
    SqrtBox["2"]], "]"}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]}]]], "Output",
 CellChangeTimes->{{3.948268699182417*^9, 3.948268713470909*^9}, 
   3.9482689902515965`*^9, 3.948269045066675*^9, 3.9489718853430576`*^9, 
   3.948971936681175*^9},
 CellLabel->
  "Out[134]=",ExpressionUUID->"44d4d8a2-e02d-9344-a984-a2b17d6d5a74"],

