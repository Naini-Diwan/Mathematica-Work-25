Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "<=", "nmax"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{
    RowBox[{"xnext", "=", 
     RowBox[{"xprev", "+", "h"}]}], ";", "\[IndentingNewLine]", "      ", 
    RowBox[{"k1", "=", 
     RowBox[{"f1", "[", 
      RowBox[{"xprev", ",", "yprev"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "      ", 
    RowBox[{"k2", " ", "=", " ", 
     RowBox[{"f1", "[", 
      RowBox[{
       RowBox[{"xprev", "+", 
        RowBox[{
         FractionBox["1", "2"], "h"}]}], ",", 
       RowBox[{"yprev", "+", 
        RowBox[{
         FractionBox["1", "2"], "k1", " ", "h"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "       ", 
    RowBox[{"k3", " ", "=", " ", 
     RowBox[{"f1", "[", 
      RowBox[{
       RowBox[{"xprev", "+", 
        RowBox[{
         FractionBox["1", "2"], "h"}]}], ",", 
       RowBox[{"yprev", "+", 
        RowBox[{
         FractionBox["1", "2"], "k2", " ", "h"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "       ", 
    RowBox[{"k4", " ", "=", " ", 
     RowBox[{"f1", "[", 
      RowBox[{
       RowBox[{"xprev", "+", " ", "h"}], ",", 
       RowBox[{"yprev", "+", " ", 
        RowBox[{"k3", " ", "h"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    "      ", 
    RowBox[{"ynext", "=", 
     RowBox[{"yprev", "+", " ", 
      RowBox[{
       FractionBox["1", "6"], 
       RowBox[{"(", 
        RowBox[{"k1", "+", 
         RowBox[{"2", "k2"}], "+", 
         RowBox[{"2", "k3"}], "+", "k4"}], ")"}], "h"}]}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"datalist2", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist2", ",", 
       RowBox[{"{", 
        RowBox[{"xnext", ",", "ynext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"yprev", "=", "ynext"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"xprev", "=", "xnext"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.950597015881607*^9, 3.9505971699080772`*^9}, {
