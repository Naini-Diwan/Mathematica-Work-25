Cell[TextData[StyleBox["-----------------------------------Euler with simple \
FOR loop------------------------------------", "Subtitle"]], "Text",
 CellChangeTimes->{{3.950646375767167*^9, 
  3.950646398931531*^9}},ExpressionUUID->"d59a2847-dd63-44bd-86d4-\
79ca16547f36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"20", "x"}], "+", "8.5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yi", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xf", "=", "4"}], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmax", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"xf", "-", "xi"}], ")"}], "/", "nmax"}], "//", "N"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yprev", "=", "yi"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xprev", "=", "xi"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datalist", "=", 
   RowBox[{"Append", "[", 
    RowBox[{"datalist", ",", 
     RowBox[{"{", 
      RowBox[{"xprev", ",", "yprev"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "1"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "<=", "nmax"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", "      ", 
   RowBox[{
    RowBox[{"xnext", "=", 
     RowBox[{"xprev", "+", "h"}]}], ";", "\[IndentingNewLine]", "      ", 
    RowBox[{"ynext", "=", 
     RowBox[{"yprev", "+", " ", 
      RowBox[{"h", "  ", 
       RowBox[{"f1", "[", 
        RowBox[{"xprev", ",", "yprev"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"datalist", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"datalist", ",", 
       RowBox[{"{", 
        RowBox[{"xnext", ",", "ynext"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "     ", 
    RowBox[{"yprev", "=", "ynext"}], ";", "\[IndentingNewLine]", "     ", 
    RowBox[{"xprev", "=", "xnext"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.950595348366321*^9, 3.950595350209898*^9}, {
  3.950595384376689*^9, 3.9505953909022837`*^9}, {3.950595423535606*^9, 
